# Copy this file to .env before running docker compose up

# --- Postgres / PostGIS ---
POSTGRES_USER=gis_user
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=fleet_tracking
POSTGRES_PORT=5432

# Built from the values above; used by the backend service
DATABASE_URL=postgresql://gis_user:change_me_locally@db:5432/fleet_tracking

# --- Backend / simulator ---
BACKEND_PORT=8000
SIM_VEHICLE_COUNT=12
SIM_TICK_SECONDS=1
# Bounding box: min_lon,min_lat,max_lon,max_lat (default: downtown San Francisco)
SIM_CITY_BBOX=-122.4294,37.7599,-122.3959,37.7899
POSITION_RETENTION_HOURS=24
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend ---
FRONTEND_PORT=3000
# No API key needed - CARTO's free, no-signup basemap style
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
